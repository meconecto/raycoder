{
  "name": "raycoder-workspace",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter raycoder dev",
    "dev:fixture": "pnpm build && node scripts/ui-fixture.mjs",
    "lint": "eslint . --max-warnings 0",
    "package:smoke": "node scripts/package-smoke.mjs",
    "package:npx-smoke": "node scripts/npx-smoke.mjs",
    "dogfood:v1": "node scripts/dogfood-v1.mjs",
    "release:artifact": "node scripts/release.mjs artifact",
    "release:publish:rc": "node scripts/release.mjs publish-rc",
    "release:promote": "node scripts/release.mjs promote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "smoke:codex": "pnpm --filter raycoder smoke:codex"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.35.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
